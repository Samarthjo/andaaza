{
  "name": "andaaza",
  "version": "0.1.0",
  "private": true,
  "description": "Andaaza: a daily estimation game for India.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/playthrough.mjs",
    "validate:questions": "vitest run src/lib/data/questions.test.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@supabase/auth-js": "^2.118.0"
  }
}
